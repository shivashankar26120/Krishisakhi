# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
# Local example: postgres://postgres:password@localhost:5432/krishisakhi
# Cloud example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/krishisakhi

# ── Authentication ────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── Python AI Service ─────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
